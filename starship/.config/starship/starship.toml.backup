################# Languages plugins ###################
[nodejs]
symbol = ''
style = 'bold green'
format = 'with [$symbol $version]($style) '
disabled = false

[custom.nextjs]
style = 'bold white'
symbol = '󰰔'
format = 'with [$symbol $output]($style) '
command = "starship toggle nodejs & node -p \"require('./package.json').dependencies.next || require('./package.json').devDependencies.next || 'N/A'\""
files = ['next.config.js', 'next.config.mjs', 'next.config.ts', '.next.config.mts']

[docker_context]
disabled = true
[custom.docker]
symbol = '🐳'
format = 'using [$symbol($output)]($style) '
files = ["Dockerfile", "docker-compose.yml", "docker-compose.yaml"]
when = '"" command -v docker &> /dev/null; exit (echo $?); ""'



