#compdef gmrc

_gmrc() {
    local ret=1
    _arguments \
        '-u[Update description of existing MR]' \
        '--update-description[Update description of existing MR]' \
        '--draft[Create MR as draft]' \
        '-h[Show help]' \
        '--help[Show help]' && ret=0
    return ret
}

_gmrc "$@"
