# Navigation par mots dans le terminal
# Unbind default alt+left/right first, then set custom bindings
keybind = option+left=unbind
keybind = option+right=unbind
keybind = option+left=text:\x1bb
keybind = option+right=text:\x1bf

# Navigation entre tabs Ghostty - Alt+[ et Alt+]
keybind = option+left_bracket=previous_tab
keybind = option+right_bracket=next_tab

# === Ghostty Native Splits (remplacement tmux) ===

# Créer des splits
keybind = option+n=new_split:right
keybind = option+v=new_split:down

# Navigation entre panes Ghostty (Alt+hjkl)
# Neovim utilise Ctrl+hjkl pour ses propres splits
keybind = option+h=goto_split:left
keybind = option+j=goto_split:down
keybind = option+k=goto_split:up
keybind = option+l=goto_split:right

# Fermer pane actuel
keybind = option+x=close_surface

# Redimensionnement des panes Ghostty (Alt+Shift+hjkl)
keybind = option+shift+h=resize_split:left,10
keybind = option+shift+j=resize_split:down,5
keybind = option+shift+k=resize_split:up,5
keybind = option+shift+l=resize_split:right,10

# Détacher/quitter (comme tmux prefix+d)
keybind = ctrl+a>d=toggle_quick_terminal

# Afficher les numéros des splits (comme tmux display-panes)
keybind = option+q=inspector:toggle

# === Suppression avancée (déplacée vers config principal) ===
# CMD+Backspace et Alt+Backspace fonctionnent bien pour supprimer
# Sélection de texte : utiliser la souris ou Shift+flèches par défaut