{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux-settings.schema.json",
  "schemaVersion": 1,

  // This file uses JSON with comments (JSONC).
  // Any setting present here overrides the GUI-saved value.
  // Remove a setting to fall back to the value saved in Settings.

  // === App ===
  "app": {
    "appearance": "system",
    "appIcon": "light",
    "newWorkspacePlacement": "afterCurrent",
    "focusPaneOnFirstClick": true,
    "reorderOnNotification": false,
    "warnBeforeQuit": false,
    "commandPaletteSearchesAllSurfaces": true
  },

  // === Terminal ===
  "terminal": {
    "showScrollBar": false
  },

  // === Notifications ===
  "notifications": {
    "sound": "Submarine",
    "dockBadge": true,
    "showInMenuBar": true,
    "unreadPaneRing": true,
    "paneFlash": true
  },

  // === Sidebar ===
  "sidebar": {
    "branchLayout": "vertical",
    "openPortLinksInCmuxBrowser": true,
    "openPullRequestLinksInCmuxBrowser": true,
    "showLog": false,
    "showNotificationMessage": true,
    "showPorts": false,
    "showProgress": true,
    "showSSH": false
  },

  // === Workspace colors ===
  "workspaceColors": {
    "indicatorStyle": "leftRail"
  },

  // === Sidebar appearance ===
  "sidebarAppearance": {
    "matchTerminalBackground": true,
    "tintColor": "#000000",
    "tintOpacity": 0.18
  },

  // === Browser ===
  "browser": {
    "theme": "system",
    "defaultSearchEngine": "google",
    "openTerminalLinksInCmuxBrowser": true,
    "interceptTerminalOpenCommandInCmuxBrowser": true
  },

  // === Shortcuts ===
  // Only overrides what differs from cmux defaults.
  // Ghostty-level bindings pass through into cmux surfaces natively.
  "shortcuts": {
    "showModifierHoldHints": true,
    "bindings": {
      // Cmd+T = new workspace, Cmd+Shift+T = new surface, Cmd+N = new cmux window.
      "newTab": "cmd+t",
      "newSurface": "cmd+shift+t",
      "newWindow": "cmd+n",

      // Override default Ctrl+Cmd+]/[ → Cmd+]/[ for sidebar nav.
      "nextSidebarTab": "cmd+]",
      "prevSidebarTab": "cmd+["
    }
  }
}
