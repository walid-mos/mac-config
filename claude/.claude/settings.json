{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(ssh:*)",
      "Bash(ssh-add:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(nvim:*)",
      "Bash(stow:*)",
      "Bash(docker:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(colima:*)",
      "Bash(node:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(sqlite3:*)",
      "Bash(for:*)",
      "Bash(.:*)",
      "Bash(mkdir:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(cmux:*)",
      "mcp__claude_ai_Context7__*",
      "mcp__context7__*",
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(curl * | zsh *)",
      "Bash(curl * --upload-file *)",
      "Bash(curl * -T *)",
      "Bash(curl * -X DELETE *)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*.github.com",
        "*.npmjs.org",
        "*.gitlab.com",
        "*.influxdata.com",
        "*.githubusercontent.com",
        "*.rust-lang.org",
        "*.crates.io",
        "*.astro.build",
        "*.playwright.dev",
        "*.googleapis.com",
        "*.linear.app",
        "*.datadoghq.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/",
        "/tmp"
      ]
    },
    "excludedCommands": [
      "git:*",
      "docker:*",
      "colima:*",
      "ssh:*",
      "ssh-add:*",
      "curl:*",
      "brew:*",
      "tailscale:*",
      "gh:*",
      "cmux:*",
      "open:*"
    ]
  },
  "skillListingBudgetFraction": 0.02,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
