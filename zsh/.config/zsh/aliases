# =============================================================================
# Aliases
# =============================================================================

alias szsh="source ~/.zshrc"
alias getip="ifconfig | grep \"inet \" | grep -v 127.0.0.1"

# Git - unalias OMZ conflicts
unalias gf 2>/dev/null
unalias gl 2>/dev/null

# Git - basics
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend --no-edit"
alias gd="git diff"
alias gds="git diff --staged"

# Git - branches
alias gb="git branch"
alias gsw="git switch"
alias gcb="git switch -c"

# Git - log
alias gl="git log --oneline --graph --decorate --all"

# Git - remote
alias gp="git push"
alias gpf="git push --force-with-lease"
alias gpl="git pull --all"

# Git - rebase
alias gr="git rebase"

# Git - stash
alias gst="git stash"
alias gstp="git stash pop"

# Git - restore
alias grs="git restore --staged"

# Worktrees
alias ws="wt spawn"
alias wtn="wt new"
alias wts="wt switch"
alias wtl="wt list"
alias wtc="wt clean"
alias wtp="wt prune"
alias wtst="wt status"

# Editor
alias v="nvim"
alias oc="opencode"

# Mac Studio (hosts dans ~/.ssh/config ; connexion = fn autoloadée functions/studio)
alias studio-local="studio macstudio-local"
alias studio-vnc="open vnc://walid-mos@macstudio-de-walid.tail4df91e.ts.net"
alias studio-vnc-local="open vnc://walid-mos@macstudio-de-walid.local"

# Navigation - quick cd to important dirs
alias cdev="cd ~/Development"
alias cddl="cd ~/Downloads"
alias cdstow="cd ~/.stow_repository"
alias cdcfg="cd ~/.config"



