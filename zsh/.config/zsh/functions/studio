#!/bin/zsh
# studio — mosh vers le Mac Studio : session « infinie » (survit à la veille du
# laptop, aux changements de réseau et aux coupures) + déverrouillage auto du
# trousseau distant (SSH ne déverrouille jamais le login keychain ;
# git/Claude Code/codesign échoueraient).
#
# Sans tty, `security unlock-keychain` ne peut pas prompter et securityd
# déverrouille via la session console ouverte du Studio — aucun mdp requis.
# Session console fermée (reboot, logout) : fallback avec le mdp de session du
# Studio lu depuis le trousseau LOCAL (entrée `studio-keychain`, créée par
# `security add-generic-password -a walid-mos -s studio-keychain -T /usr/bin/security -w`)
# et passé par stdin — jamais en clair dans le repo ni l'historique.
# L'état du trousseau est lié à la connexion SSH (session de sécurité), pas au
# canal : on déverrouille donc sur un canal sans tty d'une connexion ControlMaster,
# puis mosh bootstrap sur la MÊME connexion (--ssh mux) — mosh-server et le shell
# qu'il lance héritent du trousseau déverrouillé pour toute leur durée de vie,
# reconnexions comprises.
# Chemin absolu /opt/homebrew : mosh-server est lancé hors shell interactif,
# donc sans le PATH Homebrew.
#
# Usage: studio [host]   (défaut : macstudio)

studio() {
	emulate -L zsh

	local host=${1:-macstudio}
	local -a mux=(-o ControlMaster=auto -o "ControlPath=$HOME/.ssh/studio-%C" -o ControlPersist=60)

	ssh $mux $host 'security unlock-keychain' </dev/null >/dev/null 2>&1 \
		|| security find-generic-password -s studio-keychain -w 2>/dev/null \
			| ssh $mux $host 'IFS= read -r pw; security unlock-keychain -p "$pw"' >/dev/null 2>&1 \
		|| print -u2 "studio : déverrouillage du trousseau distant échoué (secret local studio-keychain absent ou mdp incorrect ?)"
	mosh --ssh="ssh $mux" --server=/opt/homebrew/bin/mosh-server $host
}
