#!/bin/zsh
# Shared utilities for git PR/MR creation tools (gprc and gmrc)
# This module provides platform-agnostic functions for branch management,
# AI generation, and git operations.

# Prevent double-sourcing
[[ -n "${GIT_PR_COMMON_LOADED}" ]] && return 0
GIT_PR_COMMON_LOADED=1

# ============================================================================
# CONSTANTS AND CONFIGURATION
# ============================================================================

# Default branches to check for (in order of preference)
[[ -z "$DEFAULT_BRANCHES" ]] && DEFAULT_BRANCHES=("develop" "main" "master")

# Diff size thresholds
[[ -z "$MAX_LINES_CHANGED" ]] && MAX_LINES_CHANGED=5000
[[ -z "$MAX_DIFF_SIZE" ]] && MAX_DIFF_SIZE=100000
[[ -z "$MAX_FILES_CHANGED" ]] && MAX_FILES_CHANGED=50

# Git diff exclusions
[[ -z "$DIFF_EXCLUSIONS" ]] && DIFF_EXCLUSIONS=(
    ':(exclude)package-lock.json'
    ':(exclude)yarn.lock'
    ':(exclude)Cargo.lock'
    ':(exclude)*.lock'
    ':(exclude)dist'
    ':(exclude)build'
    ':(exclude)node_modules'
    ':(exclude).next'
    ':(exclude)*.min.js'
    ':(exclude)*.bundle.js'
)

# Find Claude CLI dynamically in PATH
git_pr_common::find_claude_cli() {
    command -v claude 2>/dev/null
}

# Cache Claude CLI path at module load (dynamic detection)
[[ -z "$CLAUDE_CLI_PATH" ]] && CLAUDE_CLI_PATH="$(git_pr_common::find_claude_cli)"

# ============================================================================
# CACHING SYSTEM
# ============================================================================

# Branch cache to avoid repeated git calls (namespaced to avoid conflicts)
typeset -gA GIT_PR_COMMON_BRANCH_CACHE=()

# Clear branch cache
git_pr_common::clear_branch_cache() {
    GIT_PR_COMMON_BRANCH_CACHE=()
}

# Cached branch check (local)
git_pr_common::branch_exists_local_cached() {
    local branch="$1"
    local cache_key="local_$branch"

    if [[ -z "${GIT_PR_COMMON_BRANCH_CACHE[$cache_key]}" ]]; then
        if git show-ref --verify --quiet "refs/heads/$branch"; then
            GIT_PR_COMMON_BRANCH_CACHE[$cache_key]="1"
        else
            GIT_PR_COMMON_BRANCH_CACHE[$cache_key]="0"
        fi
    fi

    [ "${GIT_PR_COMMON_BRANCH_CACHE[$cache_key]}" = "1" ]
}

# Cached remote branch check
git_pr_common::branch_exists_remote_cached() {
    local branch="$1"
    local cache_key="remote_$branch"

    if [[ -z "${GIT_PR_COMMON_BRANCH_CACHE[$cache_key]}" ]]; then
        if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
            GIT_PR_COMMON_BRANCH_CACHE[$cache_key]="1"
        else
            GIT_PR_COMMON_BRANCH_CACHE[$cache_key]="0"
        fi
    fi

    [ "${GIT_PR_COMMON_BRANCH_CACHE[$cache_key]}" = "1" ]
}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

# Check if command exists
git_pr_common::command_exists() {
    command -v "$1" &> /dev/null
}

# Check if we're in a git repository
git_pr_common::is_git_repo() {
    git rev-parse --git-dir > /dev/null 2>&1
}

# Validate dependencies (platform-agnostic parts)
git_pr_common::validate_base_dependencies() {
    if ! git_pr_common::is_git_repo; then
        echo "❌ Not in a git repository"
        return 1
    fi

    if ! git_pr_common::command_exists fzf; then
        echo "❌ fzf is required for interactive branch selection. Install it with: brew install fzf"
        return 1
    fi

    if [ -z "$CLAUDE_CLI_PATH" ] || [ ! -x "$CLAUDE_CLI_PATH" ]; then
        echo "⚠️  Claude CLI not found in PATH"
        echo "   Will use fallback title generation"
        echo ""
        echo "💡 To install: curl -fsSL https://claude.ai/install.sh | bash"
    elif ! git_pr_common::command_exists timeout; then
        echo "⚠️  timeout command not available. Claude calls may hang."
    fi

    return 0
}

# Check if branch exists locally
git_pr_common::branch_exists_local() {
    git show-ref --verify --quiet "refs/heads/$1"
}

# Check if branch exists on remote
git_pr_common::branch_exists_remote() {
    git show-ref --verify --quiet "refs/remotes/origin/$1"
}

# Check if local and remote branches are synced
git_pr_common::is_branch_synced() {
    local branch="$1"

    if ! git_pr_common::branch_exists_local "$branch" || ! git_pr_common::branch_exists_remote "$branch"; then
        return 1
    fi

    local local_commit=$(git rev-parse "refs/heads/$branch" 2>/dev/null)
    local remote_commit=$(git rev-parse "refs/remotes/origin/$branch" 2>/dev/null)

    [ "$local_commit" = "$remote_commit" ]
}

# Get sync status for a branch
git_pr_common::get_branch_sync_status() {
    local branch="$1"

    if ! git_pr_common::branch_exists_local "$branch" || ! git_pr_common::branch_exists_remote "$branch"; then
        echo ""
        return
    fi

    local ahead=$(git rev-list --count "origin/$branch..$branch" 2>/dev/null || echo "0")
    local behind=$(git rev-list --count "$branch..origin/$branch" 2>/dev/null || echo "0")

    if [ "$ahead" != "0" ] && [ "$behind" != "0" ]; then
        echo " ($ahead ahead, $behind behind)"
    elif [ "$ahead" != "0" ]; then
        echo " ($ahead ahead)"
    elif [ "$behind" != "0" ]; then
        echo " ($behind behind)"
    else
        echo ""
    fi
}

# Should include branch in selection
git_pr_common::should_include_branch() {
    local branch="$1"
    local current_branch="$2"
    local default_branch="$3"

    [ -n "$branch" ] && [ "$branch" != "$current_branch" ] && [ "$branch" != "$default_branch" ]
}

# ============================================================================
# BRANCH SELECTION FUNCTIONS
# ============================================================================

# Get default branch for repository
git_pr_common::get_default_branch() {
    for branch in "${DEFAULT_BRANCHES[@]}"; do
        if git_pr_common::branch_exists_local_cached "$branch" || git_pr_common::branch_exists_remote_cached "$branch"; then
            echo "$branch"
            return 0
        fi
    done
    echo ""
}

# Get all available branches for selection
git_pr_common::get_available_branches() {
    local current_branch="$1"
    local default_branch="$2"
    local -a branches=()
    local -A seen_branches=()

    # Add default branch first if different from current
    if [ -n "$default_branch" ] && [ "$default_branch" != "$current_branch" ]; then
        branches+=("$default_branch (default)")
        seen_branches["$default_branch"]=1
    fi

    # Process local branches
    while IFS= read -r branch; do
        if git_pr_common::should_include_branch "$branch" "$current_branch" "$default_branch" && [[ -z "${seen_branches[$branch]}" ]]; then
            if git_pr_common::is_branch_synced "$branch"; then
                branches+=("$branch")
            else
                local sync_status=$(git_pr_common::get_branch_sync_status "$branch")
                branches+=("$branch (local$sync_status)")
            fi
            seen_branches["$branch"]=1
        fi
    done < <(git branch --format='%(refname:short)')

    # Add remote-only branches (branches that exist on remote but not locally)
    while IFS= read -r remote_branch; do
        local branch=$(echo "$remote_branch" | sed 's/origin\///')
        # Skip if it's just "origin" or other non-branch refs
        if [ "$branch" = "origin" ] || [ "$branch" = "HEAD" ] || [[ "$branch" =~ ^origin$ ]]; then
            continue
        fi
        # Only add if branch doesn't exist locally and hasn't been seen yet
        # Explicit current branch check to ensure we never show the remote tracking branch of the current branch
        if [ "$branch" != "$current_branch" ] && git_pr_common::should_include_branch "$branch" "$current_branch" "$default_branch" && [[ -z "${seen_branches[$branch]}" ]] && ! git_pr_common::branch_exists_local_cached "$branch"; then
            branches+=("$branch (remote)")
            seen_branches["$branch"]=1
        fi
    done < <(git branch -r --format='%(refname:short)' | grep -v 'origin/HEAD' | grep -v '^origin$')

    printf '%s\n' "${branches[@]}"
}

# Interactive branch selection with fzf
git_pr_common::select_target_branch() {
    local current_branch="$1"
    local default_branch=$(git_pr_common::get_default_branch)

    local branches_output=$(git_pr_common::get_available_branches "$current_branch" "$default_branch")

    if [ -z "$branches_output" ]; then
        echo "❌ No target branches available (current: $current_branch)" >&2
        return 1
    fi

    local selected=$(echo "$branches_output" | fzf \
        --prompt="Target branch: " \
        --height=40% \
        --border \
        --header="Select target branch for PR/MR (↑↓ to navigate, Enter to select)" \
        --preview-window=hidden)

    if [ -z "$selected" ]; then
        echo "❌ No branch selected" >&2
        return 1
    fi

    # Extract branch name (remove annotations)
    echo "$selected" | sed -E 's/ \([^)]+\)$//'
}

# ============================================================================
# PROGRESS INDICATORS
# ============================================================================

# Simple spinner for long operations
git_pr_common::show_spinner() {
    local pid=$1
    local message="$2"
    local spin='⣾⣽⣻⢿⡿⣟⣯⣷'
    local i=0

    while kill -0 "$pid" 2>/dev/null; do
        printf "\r%s %s" "${spin:$i:1}" "$message"
        i=$(( (i+1) % ${#spin} ))
        sleep 0.1
    done
    printf "\r✅ %s\n" "$message"
}

# ============================================================================
# AI GENERATION FUNCTIONS
# ============================================================================

# Safe Claude CLI wrapper with timeout
git_pr_common::call_claude_cli() {
    local input="$1"
    local timeout_seconds="${2:-30}"

    if [ -z "$CLAUDE_CLI_PATH" ] || [ ! -x "$CLAUDE_CLI_PATH" ]; then
        return 1
    fi

    if git_pr_common::command_exists timeout; then
        echo "$input" | timeout "$timeout_seconds" "$CLAUDE_CLI_PATH" 2>&1
    else
        echo "$input" | "$CLAUDE_CLI_PATH" 2>&1
    fi
}

# Generate PR/MR title using Claude CLI
git_pr_common::generate_ai_title() {
    local target_branch="$1"
    local current_branch="$2"
    local terminology="${3:-PR}"  # "PR" or "MR"

    local commits=$(git log "$target_branch..$current_branch" --oneline --no-merges)
    local files=$(git diff "$target_branch...$current_branch" --name-only | head -10)

    local claude_input="Generate a descriptive English ${terminology} title (max 70 characters) that clearly explains what this ${terminology} accomplishes from a user/business perspective.

Style guidelines:
- Use natural English sentences, not commitlint format (no \"feat:\", \"fix:\", etc.)
- Focus on WHAT the change does, not HOW it's implemented
- Make it readable for non-technical stakeholders
- Examples of good titles:
  * \"Add email notification system for user registration\"
  * \"Improve dashboard loading performance\"
  * \"Fix authentication issues on mobile devices\"

Avoid:
- Commitlint prefixes (feat:, fix:, chore:, etc.)
- Technical jargon when possible
- Vague descriptions like \"update code\" or \"refactor\"

=== COMMITS ===
$commits

=== FILES AFFECTED ===
$files

Generate only the title, nothing else."

    local claude_response
    if claude_response=$(git_pr_common::call_claude_cli "$claude_input" 30); then
        echo "$claude_response" | tr -d '\n' | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//'
    else
        # Fallback to first commit message
        echo "⚠️  Claude CLI failed, using fallback title" >&2
        git log -1 --pretty=%B | head -n1
    fi
}

# Check if diff is too large for analysis
git_pr_common::is_diff_too_large() {
    local target_branch="$1"
    local current_branch="$2"

    local numstat=$(git diff "$target_branch..$current_branch" --numstat)
    local total_lines_changed=0
    local files_changed=0

    while IFS=$'\t' read -r added removed filename; do
        if [ -n "$added" ] && [ -n "$removed" ] && [ "$added" != "-" ] && [ "$removed" != "-" ]; then
            total_lines_changed=$((total_lines_changed + added + removed))
            files_changed=$((files_changed + 1))
        fi
    done <<< "$numstat"

    local diff_content=$(git diff "$target_branch..$current_branch" -- . "${DIFF_EXCLUSIONS[@]}")
    local diff_size=${#diff_content}

    if [ $total_lines_changed -gt $MAX_LINES_CHANGED ] || [ $diff_size -gt $MAX_DIFF_SIZE ] || [ $files_changed -gt $MAX_FILES_CHANGED ]; then
        echo "⚠️  Large diff detected ($total_lines_changed lines changed, $files_changed files, $diff_size chars), using summary mode"
        return 0
    fi

    return 1
}

# Generate AI analysis using Claude CLI
git_pr_common::generate_ai_analysis() {
    local target_branch="$1"
    local current_branch="$2"
    local terminology="${3:-PR}"  # "PR" or "MR"

    local stats=$(git diff "$target_branch..$current_branch" --stat | tail -n1)
    local commits=$(git log "$target_branch..$current_branch" --oneline --no-merges)
    local files=$(git diff "$target_branch..$current_branch" --name-status)

    local claude_input="Analyze this Git ${terminology} and generate a summary in English:

=== STATS ===
$stats

=== COMMITS ===
$commits

=== FILES CHANGED ===
$files
"

    if ! git_pr_common::is_diff_too_large "$target_branch" "$current_branch"; then
        local diff_content=$(git diff "$target_branch..$current_branch" -- . "${DIFF_EXCLUSIONS[@]}")
        claude_input+="
=== DIFF CONTENT ===
$diff_content
"
    fi

    claude_input+="
Response format:
## Summary
[Concise description of what this ${terminology} does]

## Changes
[Detailed analysis of changes by category with relevant technical details]"

    local claude_response
    if claude_response=$(git_pr_common::call_claude_cli "$claude_input" 45); then
        echo "$claude_response"
    else
        # Fallback analysis
        echo "⚠️  Claude CLI failed, using fallback analysis" >&2
        echo "## Summary"
        echo "This ${terminology} includes changes across $(echo "$files" | wc -l | tr -d ' ') files."
        echo ""
        echo "## Changes"
        echo "$stats"
        echo ""
        echo "### Recent Commits"
        echo "$commits" | sed 's/^/- /'
        echo ""
        echo "### Files Modified"
        echo "$files" | sed 's/^/- /'
    fi
}

# Create PR/MR body with AI analysis
git_pr_common::create_pr_body() {
    local target_branch="$1"
    local current_branch="$2"
    local terminology="${3:-PR}"  # "PR" or "MR"
    local signature="${4:-gprc}"  # "gprc" or "gmrc"

    local analysis=$(git_pr_common::generate_ai_analysis "$target_branch" "$current_branch" "$terminology")

    cat <<EOF
$analysis

---
🤖 Generated with $signature made by Walid + Claude
EOF
}

# ============================================================================
# BRANCH PUSH HELPER
# ============================================================================

# Ensure branch is pushed to remote
git_pr_common::ensure_branch_pushed() {
    local current_branch="$1"

    if git_pr_common::branch_exists_remote_cached "$current_branch"; then
        echo "🔄 Pulling latest changes with rebase..."
        if ! git pull --rebase origin "$current_branch"; then
            echo ""
            echo "❌ Rebase failed. Please resolve conflicts and try again."
            echo "💡 After resolving conflicts, run: git rebase --continue"
            return 1
        fi
        echo "✅ Branch up to date"
    else
        echo ""
        echo "⚠️  Current branch '$current_branch' does not exist on remote"
        echo "💡 Push it first with: git push -u origin $current_branch"
        return 1
    fi
}
