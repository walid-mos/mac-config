#!/bin/zsh
# goloop - Chain `claude -p "/go next"` runs, fresh context each time,
#          paced by Enter between iterations.
#
# Why fresh context per call: state lives on disk (plan.md / tasks.json),
# so we skip --resume to avoid carrying compaction state across tasks.
# --dangerously-skip-permissions (default) keeps /go from stalling on
# permission prompts mid-loop; pass --safe to keep them.

if ! command -v claude >/dev/null 2>&1; then
    echo "❌ claude CLI not found in PATH"
    return 1
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "❌ Not in a git repository"
    return 1
fi

# Print a banner with the next [ ] task from the active /go plan, if any.
# Mirrors how `/go next` itself locates plans: most recent `/tmp/claude/go-*`
# with at least one `[ ]` or `[~]` line. The slug in the dir name is a Linear
# project slug, not the git slug, so we can't filter by repo without reading
# the workspace bindings — picking the most recent active plan is enough.
_goloop_show_next_task() {
    _GOLOOP_TASK_ID=""
    _GOLOOP_TASK_TITLE=""

    local plan=""
    local d
    for d in ${(f)"$(ls -dt /tmp/claude/go-*-p*-* 2>/dev/null)"}; do
        if [[ -f "$d/plan.md" ]] && grep -qE '^- \[[ ~]\] ' "$d/plan.md"; then
            plan="$d/plan.md"
            break
        fi
    done
    [[ -z "$plan" ]] && return 0

    # Skip blocked tasks (lines starting with `- [ ] ⚠ `) — they remain
    # unchecked but should not be picked by `/go next` until unblocked.
    local next_line
    next_line=$(grep -E '^- \[ \] ' "$plan" | grep -v '^- \[ \] ⚠' | head -1)
    [[ -z "$next_line" ]] && return 0

    local phase
    phase=$(sed -nE 's/^# Phase ([0-9]+).*/\1/p' "$plan" | head -1)

    local workspace
    workspace=$(sed -nE 's#^Linear: https://linear\.app/([^/]+)/.*#\1#p' "$plan" | head -1)

    _GOLOOP_TASK_ID=$(echo "$next_line" | sed -E 's/^- \[ \] ([^ ]+) .*/\1/')
    _GOLOOP_TASK_TITLE=$(echo "$next_line" | sed -E 's/^- \[ \] [^ ]+ //')

    echo "📋 Phase ${phase:-?} — ${_GOLOOP_TASK_ID} ${_GOLOOP_TASK_TITLE}"
    if [[ -n "$workspace" && -n "$_GOLOOP_TASK_ID" ]]; then
        echo "🔗 https://linear.app/${workspace}/issue/${_GOLOOP_TASK_ID}"
    fi
}

local skip_perms=true
while [[ $# -gt 0 ]]; do
    case $1 in
        --safe)            skip_perms=false; shift ;;
        -h|--help)
            echo "Usage: goloop [--safe]"
            echo ""
            echo "Runs '/go next' in a fresh Claude context, one task at a time,"
            echo "pausing for Enter between tasks. Press 'q' + Enter to stop."
            echo ""
            echo "  --safe   Keep permission prompts (default: bypass them)."
            return 0
            ;;
        *) echo "❌ Unknown option: $1"; return 1 ;;
    esac
done

local -a claude_args
claude_args=(-p "/go next")
if $skip_perms; then
    claude_args=(--dangerously-skip-permissions "${claude_args[@]}")
fi

local branch=$(git branch --show-current)
local count=0
local failures=0
local start_ts=$(date +%s)

echo "🔁 goloop — chaining /go next on branch ${branch:-<detached>}"
echo "   Enter = next task, 'q' + Enter = stop."
if ! $skip_perms; then
    echo "   ⚠️  --safe mode: claude may stall on permission prompts."
fi
echo

local prev_task_id=""
while true; do
    count=$((count + 1))
    local task_start=$(date +%s)
    echo "─── Task $count ─────────────────────────────"
    _goloop_show_next_task
    local task_id="$_GOLOOP_TASK_ID"
    local task_title="$_GOLOOP_TASK_TITLE"
    echo

    # If `/go next` was a no-op (same `[ ]` task as last iteration), the
    # previous run stalled — Linear out of sync, sandbox block, push
    # rejected, etc. Don't pretend it shipped; surface and stop.
    if [[ -n "$task_id" && "$task_id" == "$prev_task_id" ]]; then
        failures=$((failures + 1))
        echo "⚠️  Task $task_id did not advance on the previous /go next."
        echo "    Same task is still [ ] in plan.md. Stopping the loop —"
        echo "    investigate (Linear sync? push rejected? blocked?) and"
        echo "    rerun goloop once unstuck."
        count=$((count - 1))
        break
    fi

    # </dev/null guards against claude ever blocking on stdin.
    if ! claude "${claude_args[@]}" </dev/null; then
        failures=$((failures + 1))
        echo "⚠️  claude exited non-zero on task $count"
    fi

    local task_dur=$(( $(date +%s) - task_start ))
    echo
    if [[ -n "$task_id" ]]; then
        echo "✓ Task $count — ${task_id} ${task_title} (${task_dur}s)"
    else
        echo "✓ Task $count finished in ${task_dur}s"
    fi
    prev_task_id="$task_id"
    echo

    printf "↩️  Enter for next task, 'q' + Enter to stop: "
    local answer
    if ! read -r answer; then
        # Ctrl-D / EOF
        echo
        break
    fi
    case "$answer" in
        q|Q|quit|exit) break ;;
    esac
    echo
done

local total=$(( $(date +%s) - start_ts ))
local mins=$((total / 60))
local secs=$((total % 60))
local avg="-"
if [[ "$count" -gt 0 ]]; then
    avg="$((total / count))s"
fi

echo
echo "═══ goloop summary ════════════════════════════"
echo "  Branch:        ${branch:-<detached>}"
echo "  Tasks run:     $count"
echo "  Failures:      $failures"
echo "  Total time:    ${mins}m ${secs}s"
echo "  Avg / task:    $avg"

if command -v gh >/dev/null 2>&1; then
    local pr_url=$(gh pr view --json url -q .url 2>/dev/null)
    if [[ -n "$pr_url" ]]; then
        echo "  PR for review: $pr_url"
    else
        echo "  PR:            (none yet — open one with /pr)"
    fi
fi
echo "═══════════════════════════════════════════════"
