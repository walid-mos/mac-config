# Filtres de normalisation — les scripts référencés sont configurés dans
# .git/config par `make git-filters` (à rejouer après chaque clone).

# settings.json est réécrit par pi à la volée (modèle actif, changelog vu) :
# le filtre clean normalise ces clés pour que git ne bouge que sur les vrais
# changements de config. Valeurs canoniques : scripts/git-filter-pi-settings-clean.sh
pi/.pi/agent/settings.json filter=pi-settings

# Les patches pnpm sont des diffs unifiés : leurs lignes de contexte commencent
# nécessairement par un espace avant l'indentation originale, souvent une tab.
pi/.pi/agent/npm-patches/*.patch -whitespace

# Hermes réécrit les trois clés de modèle actif à chaque changement de modèle.
# Le filtre les normalise sans masquer les autres changements de config.
# Valeurs canoniques : scripts/git-filter-hermes-config-clean.sh
hermes/.hermes/config.yaml filter=hermes-config

# settings.json est réécrit par Claude Code à la volée (modèle actif via
# /model) : même mécanisme. Valeur canonique : scripts/git-filter-claude-settings-clean.sh
claude/.claude/settings.json filter=claude-settings
