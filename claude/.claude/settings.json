{
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-4-5-20250929",
    "TMPDIR": "/tmp/claude",
    "PLANE_WORKSPACE_SLUG": "nextnode-internals"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill",
      "WebFetch",
      "WebSearch",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:api.githubcopilot.com)",
      "mcp__*",
      "mcp__plane",
      "mcp__plane__*",
      "mcp__context7",
      "mcp__context7__*",
      "mcp__plugin_context7_context7",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_github_github",
      "mcp__plugin_github_github__*",
      "mcp__claude_ai_Notion",
      "mcp__claude_ai_Notion__*",
      "mcp__claude_ai_Linear",
      "mcp__claude_ai_Linear__*",
      "mcp__claude_ai_HubSpot",
      "mcp__claude_ai_HubSpot__*",
      "mcp__claude_ai_Context7",
      "mcp__claude_ai_Context7__*"
    ],
    "deny": []
  },
  "hooks": {},
  "allowManagedPermissionRulesOnly": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "terraform-provider-development@hashicorp": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    },
    "supabase": {
      "source": {
        "source": "github",
        "repo": "supabase/agent-skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "ignoreViolations": {
      "*": [
        "/Users/walid/"
      ]
    }
  },
  "autoUpdatesChannel": "latest",
  "effortLevel": "high"
}
