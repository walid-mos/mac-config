{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanificationOutput",
  "description": "Complete output of the Planification Agent",
  "type": "object",
  "required": [
    "taskList",
    "executionPlan",
    "testingBrief",
    "reuseMap",
    "humanPrerequisites",
    "specUpdates",
    "warnings",
    "troubleshootingApplied"
  ],
  "additionalProperties": false,
  "properties": {
    "taskList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskItem"
      }
    },
    "executionPlan": {
      "$ref": "#/$defs/ExecutionPlan"
    },
    "testingBrief": {
      "$ref": "#/$defs/TestingBrief"
    },
    "reuseMap": {
      "$ref": "#/$defs/ReuseMap"
    },
    "humanPrerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HumanPrerequisite"
      }
    },
    "specUpdates": {
      "type": ["string", "null"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "troubleshootingApplied": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "TaskItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "specItems",
        "files",
        "dependencies",
        "specialist",
        "testingStrategy",
        "testingRationale",
        "acceptanceCriteria",
        "antiPatterns",
        "sharedContext",
        "complexity",
        "notes"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "specItems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files": {
          "type": "object",
          "required": ["reuses", "extends", "creates"],
          "properties": {
            "reuses": {
              "type": "array",
              "items": { "type": "string" }
            },
            "extends": {
              "type": "array",
              "items": { "type": "string" }
            },
            "creates": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "specialist": { "type": "string" },
        "testingStrategy": {
          "type": "string",
          "enum": ["tdd-strict", "tdd-flexible", "post-code"]
        },
        "testingRationale": { "type": "string" },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "antiPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sharedContext": {
          "type": "array",
          "items": { "type": "string" }
        },
        "complexity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "notes": { "type": "string" }
      }
    },
    "ExecutionPlan": {
      "type": "object",
      "required": ["parallel", "serial", "reason"],
      "properties": {
        "parallel": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": "Groups of task IDs that can run concurrently"
        },
        "serial": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": "Groups that must run in sequence"
        },
        "reason": {
          "type": "string",
          "description": "Why this ordering was chosen"
        }
      }
    },
    "TestingBrief": {
      "type": "object",
      "required": ["items", "globalContext", "summary"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestingBriefItem"
          }
        },
        "globalContext": {
          "type": "object",
          "required": ["techStack", "testFramework", "testConfigPath", "existingPatterns"],
          "properties": {
            "techStack": {
              "type": "array",
              "items": { "type": "string" }
            },
            "testFramework": { "type": "string" },
            "testConfigPath": { "type": ["string", "null"] },
            "existingPatterns": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "summary": {
          "type": "object",
          "required": ["totalTasks", "byStrategy"],
          "properties": {
            "totalTasks": { "type": "integer" },
            "byStrategy": {
              "type": "object",
              "required": ["tddStrict", "tddFlexible", "postCode"],
              "properties": {
                "tddStrict": { "type": "integer" },
                "tddFlexible": { "type": "integer" },
                "postCode": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "TestingBriefItem": {
      "type": "object",
      "required": [
        "taskId",
        "title",
        "strategy",
        "strategyRationale",
        "acceptanceCriteria",
        "edgeCases",
        "errorPaths",
        "importsToMock",
        "importsToKeepReal",
        "antiPatterns",
        "targetFiles",
        "existingTestFiles",
        "existingTestUtilities",
        "testNotes",
        "sharedContext",
        "dependsOnTasks"
      ],
      "properties": {
        "taskId": { "type": "string" },
        "title": { "type": "string" },
        "strategy": {
          "type": "string",
          "enum": ["tdd-strict", "tdd-flexible", "post-code"]
        },
        "strategyRationale": { "type": "string" },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "edgeCases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "errorPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "importsToMock": {
          "type": "array",
          "items": { "type": "string" }
        },
        "importsToKeepReal": {
          "type": "array",
          "items": { "type": "string" }
        },
        "antiPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targetFiles": {
          "type": "object",
          "required": ["creates", "extends"],
          "properties": {
            "creates": {
              "type": "array",
              "items": { "type": "string" }
            },
            "extends": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "existingTestFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "existingTestUtilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "testNotes": { "type": "string" },
        "sharedContext": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependsOnTasks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ReuseMap": {
      "type": "object",
      "required": ["assets", "taskMapping", "fileConflicts"],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReuseAsset"
          }
        },
        "taskMapping": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["reuses", "extends", "creates"],
            "properties": {
              "reuses": {
                "type": "array",
                "items": { "type": "string" }
              },
              "extends": {
                "type": "array",
                "items": { "type": "string" }
              },
              "creates": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "description": "Keyed by TaskItem.id"
        },
        "fileConflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "taskIds", "resolution", "note"],
            "properties": {
              "path": { "type": "string" },
              "taskIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "resolution": {
                "type": "string",
                "enum": ["serialize", "merge"]
              },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "ReuseAsset": {
      "type": "object",
      "required": ["path", "type", "exports", "description", "usedByTasks"],
      "properties": {
        "path": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["component", "hook", "utility", "service", "type", "config", "style", "test-utility"]
        },
        "exports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "usedByTasks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "HumanPrerequisite": {
      "type": "object",
      "required": ["id", "description", "blocksTaskIds", "category", "urgency", "verificationHint"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "blocksTaskIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "category": {
          "type": "string",
          "enum": ["secret", "external-service", "infrastructure", "access", "manual"]
        },
        "urgency": {
          "type": "string",
          "enum": ["before-impl", "before-deploy"]
        },
        "verificationHint": { "type": "string" }
      }
    }
  }
}
