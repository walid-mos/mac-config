alias v="nvim"
alias szsh="source ~/.zshrc"

alias cdev="cd ~/Development"
alias cdconfig="cd ~/.config/"
alias cdstow="cd ~/.stow_repository/"

alias c="tput reset"

# Git aliases - these override oh-my-zsh defaults
unalias gf 2>/dev/null
unalias gl 2>/dev/null

# Force override oh-my-zsh gl alias
alias gl="git log --oneline --graph --decorate --all"

# Other git aliases
alias gs="git switch"
alias gst="git status"
alias gpl="git pull --all"
alias ga="git add"
alias gc="git commit"
alias gr="git rebase"
alias gp="git push"

# Claude CLI management
alias upclaude="pnpm update -g @anthropic-ai/claude-code --latest"
