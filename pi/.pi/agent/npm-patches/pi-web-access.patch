@@ -0,0 +1,133 @@
+import type { Component } from "@earendil-works/pi-tui";
+
+/**
+ * Bridge to the compact-tools style facade. The compact-tools extension
+ * publishes the shared row implementation on a process-global slot before npm
+ * packages load; this module only forwards the web tools' own subject, summary
+ * and expanded bodies onto that facade. Row composition, glyphs, stacking and
+ * truncation live in compact-tools — this file holds no style of its own.
+ */
+
+const COMPACT_STYLE_SLOT = "piCompactStyle";
+
+export interface CompactComponent {
+	render(width: number): string[];
+	invalidate(): void;
+}
+
+export interface CompactTheme {
+	fg(role: string, text: string): string;
+	bold(text: string): string;
+}
+
+export interface CompactToolResult {
+	content: ReadonlyArray<{ type: string; text?: string }>;
+	isError?: boolean;
+}
+
+export interface RowOptions {
+	expanded?: boolean;
+	isPartial?: boolean;
+}
+
+export interface RowContext {
+	state: Record<string, unknown>;
+	[key: string]: unknown;
+}
+
+export type RowBody = (
+	result: CompactToolResult,
+	options: RowOptions,
+	theme: CompactTheme,
+	context: RowContext,
+) => CompactComponent;
+
+export interface CompactRowContent {
+	subject?: (args: unknown) => string;
+	summary?: (result: CompactToolResult) => string;
+	expanded?: RowBody;
+}
+
+export interface RowRenderers {
+	renderCall: (args: unknown, theme: CompactTheme, context: RowContext) => CompactComponent;
+	renderResult: (
+		result: CompactToolResult,
+		options: RowOptions,
+		theme: CompactTheme,
+		context: RowContext,
+	) => CompactComponent;
+}
+
+interface StyleApi {
+	createRowRenderers(tool: string, content: CompactRowContent): RowRenderers;
+	composeRowLine(
+		view: {
+			tool: string;
+			subject: string;
+			state: { status?: string; summary?: string };
+			theme: CompactTheme;
+		},
+		width: number,
+		theme: CompactTheme,
+	): string;
+}
+
+function resolveStyle(): StyleApi {
+	const style = (globalThis as Record<string, unknown>)[COMPACT_STYLE_SLOT];
+	if (
+		typeof style !== "object" ||
+		style === null ||
+		typeof (style as StyleApi).createRowRenderers !== "function"
+	) {
+		throw new Error(
+			"compact-tools style facade is not published; the compact-tools extension must be enabled",
+		);
+	}
+	return style as StyleApi;
+}
+
+/** Shared compact rows for one tool; the facade is resolved on first render. */
+export function createWebRows(tool: string, content: CompactRowContent): RowRenderers {
+	let rows: RowRenderers | undefined;
+	const resolved = () => (rows ??= resolveStyle().createRowRenderers(tool, content));
+	return {
+		renderCall: (args, theme, context) => resolved().renderCall(args, theme, context),
+		renderResult: (result, options, theme, context) =>
+			resolved().renderResult(result, options, theme, context),
+	};
+}
+
+/** One themed compact line for a custom message, truncated to the width. */
+export function messageRow(
+	label: string,
+	status: "ok" | "error" | "pending" | "notice",
+	subject: string,
+	summary: string,
+	theme: CompactTheme,
+	outputPad: number,
+): CompactComponent {
+	return {
+		render(width: number) {
+			const line = resolveStyle().composeRowLine(
+				{ tool: label, subject, state: { status, summary }, theme },
+				Math.max(1, width - outputPad),
+				theme,
+			);
+			return [`${" ".repeat(outputPad)}${line}`];
+		},
+		invalidate() {},
+	};
+}
+
+export function firstText(content: ReadonlyArray<{ type: string; text?: string }>): string {
+	return content.find((entry) => entry.type === "text" && typeof entry.text === "string")?.text ?? "";
+}
+
+export function firstLine(text: string): string {
+	const index = text.indexOf("\n");
+	return (index === -1 ? text : text.slice(0, index)).trim();
+}
+
+export function emptyComponent(): CompactComponent {
+	return { render: () => [], invalidate() {} };
+}
