clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

macos-option-as-alt = left
macos-titlebar-style = transparent

window-height = 70
window-width = 320

window-padding-x = 5
window-padding-y = 2

# Configuration pour hériter du répertoire de travail dans les nouveaux onglets
window-inherit-working-directory = true
shell-integration = detect

# Activer la détection et le clic sur les URLs
link-url = true

# Support du passthrough de souris avec modificateurs pour tmux
mouse-shift-capture = false
mouse-hide-while-typing = false

# NOTE: Utilisation des splits natifs de Ghostty au lieu de tmux
