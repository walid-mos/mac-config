{
  "name": "swarm",
  "version": "0.1.0",
  "description": "AI agent orchestrator for autonomous software development",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --out-dir .local/share/swarm/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "smol-toml": "^1.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.4"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/*"
    ]
  }
}
