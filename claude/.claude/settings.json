{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(ssh:*)",
      "Bash(ssh-add:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(nvim:*)",
      "Bash(stow:*)",
      "Bash(docker:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(colima:*)",
      "Bash(node:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(sqlite3:*)",
      "Bash(for:*)",
      "Bash(.:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__claude_ai_Context7__*",
      "mcp__context7__*",
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(curl * | zsh *)",
      "Bash(curl * --upload-file *)",
      "Bash(curl * -T *)",
      "Bash(curl * -X DELETE *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/bypass-heuristics.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*.github.com",
        "*.npmjs.org",
        "*.gitlab.com",
        "*.influxdata.com",
        "*.githubusercontent.com",
        "*.rust-lang.org",
        "*.crates.io"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/"
      ]
    },
    "excludedCommands": [
      "git:*",
      "docker:*",
      "colima:*",
      "ssh:*",
      "ssh-add:*",
      "curl:*",
      "brew:*",
      "tailscale:*",
      "gh:*"
    ]
  },
  "effortLevel": "high"
}
