      "Bash(gh repo clone:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh api --method GET:*)",
      "Bash(gh auth status:*)",
      "Bash(gh config get:*)",
      "Read(~/.zshrc)",
      "Read(~/.config/zsh/**)",
      "Bash(git commit:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(curl -X POST:*)",
      "Bash(curl --request POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X DELETE:*)",
      "Bash(curl -X PATCH:*)",
      "Bash(curl -o:*)",
      "Bash(curl --output:*)",
      "Bash(curl -O:*)",
      "Bash(curl --remote-name:*)",
      "Bash(curl -d:*)",
      "Bash(curl --data:*)",
      "Bash(curl -F:*)",
      "Bash(curl --form:*)",
      "Bash(curl -T:*)",
      "Bash(curl --upload-file:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["docker", "kubectl"],
    "network": {
      "allowUnixSockets": [],
      "allowLocalBinding": true
    }
  }
}
