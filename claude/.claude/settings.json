{
  "effortLevel": "high",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": ["~/"]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "registry.npmjs.org", "gitlab.com"],
      "allowLocalBinding": true
    }
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(ssh:*)",
      "Bash(ssh-add:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(nvim:*)",

      "WebFetch(*)",
      "WebSearch(*)",

      "mcp__claude_ai_Context7__*",
      "mcp__context7__*",

      "Read",
      "Glob"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(curl * | zsh *)",
      "Bash(curl * --upload-file *)",
      "Bash(curl * -T *)",
      "Bash(curl * -X DELETE *)"
    ]
  }
}
