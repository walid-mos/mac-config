{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "https://api.accor-gpt.accor.net/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:ANTHROPIC_API_KEY}"
        }
      },
      "models": {
        "claude-sonnet-4": { "name": "Claude Sonnet 4 (AccorGPT)" },
        "claude-3-5-sonnet": { "name": "Claude 3.5 Sonnet (AccorGPT)" }
      }
    }
  }
}
