#compdef wt wtn wts wtl wtd wtc wtp

# Helper: Get all branch names (local + remote)
_wt_all_branches() {
    local -a branches
    branches+=(${(f)"$(git branch --format='%(refname:short)' 2>/dev/null)"})
    branches+=(${(f)"$(git branch -r --format='%(refname:short)' 2>/dev/null | sed 's|^[^/]*/||' | grep -v HEAD)"})
    branches=(${(u)branches})
    _describe 'branch' branches
}

# Helper: Get existing worktree branches
_wt_worktree_branches() {
    local -a branches
    branches=(${(f)"$(git worktree list --porcelain 2>/dev/null | grep '^branch' | sed 's|branch refs/heads/||')"})
    _describe 'worktree branch' branches
}

_wt() {
    local curcontext="$curcontext" state state_descr line ret=1
    typeset -A opt_args

    _arguments -C \
        '1:subcommand:->subcmd' \
        '*::arg:->args' && ret=0

    case $state in
        subcmd)
            local -a subcommands
            subcommands=(
                'new:Create new worktree for branch'
                'switch:Switch to existing worktree'
                'list:List all worktrees'
                'status:Show git status for all worktrees'
                'clean:Remove worktrees interactively'
                'prune:Remove worktrees for branches deleted on remote'
                'help:Show help message'
            )
            _describe -t subcommands 'subcommand' subcommands && ret=0
            ;;
        args)
            case $words[1] in
                new)
                    _wt_all_branches && ret=0
                    ;;
                switch)
                    _wt_worktree_branches && ret=0
                    ;;
                prune)
                    _arguments '-i[Interactive mode]' '--interactive[Interactive mode]' && ret=0
                    ;;
            esac
            ;;
    esac

    return ret
}

_wt "$@"
