{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Skill",
      "Plugin:*",
      "mcp__plugin_context7_context7",
      "mcp__plugin_claude-mem_mcp-search",
      "mcp__plugin_playwright_playwright",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch(*)",
      "WebSearch(*)",
      "Edit(/tmp/**)",
      "Edit(/Users/walid/.stow_repository/**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf .)",
      "Bash(sudo *)",
      "Bash(curl -X POST *)",
      "Bash(curl --request POST *)",
      "Bash(curl -X PUT *)",
      "Bash(curl -X DELETE *)",
      "Bash(curl -X PATCH *)",
      "Bash(curl -d *)",
      "Bash(curl --data *)",
      "Bash(curl -F *)",
      "Bash(curl --form *)",
      "Bash(curl -o *)",
      "Bash(curl -O *)",
      "Bash(curl --output *)",
      "Bash(curl --remote-name *)",
      "Bash(curl -T *)",
      "Bash(curl --upload-file *)",
      "Bash(wget *)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(//Users/walid/.ssh/**)",
      "Read(//Users/walid/.aws/**)",
      "Read(**/credentials*)",
      "Read(**/*secret*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(//Users/walid/.ssh/**)",
      "Edit(//Users/walid/.aws/**)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init.py",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/context-detector.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-tool-use.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/fallback-detector.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "plugin-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "stripe@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*",
        "github.com",
        "*.github.com",
        "api.github.com",
        "gitlab.com",
        "*.gitlab.com"
      ]
    },
    "excludedCommands": [
      "docker:*",
      "git:*",
      "gh:*",
      "glab:*"
    ]
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest"
}
