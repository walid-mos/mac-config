index 0000000000000000000000000000000000000000..b0608e01c14191b3b7087f6a1c5d720cfdbc15d0
--- /dev/null
+++ b/compact-render.ts
@@ -0,0 +1,113 @@
+import { truncateToWidth, type Component } from "@earendil-works/pi-tui";
+
+export type CompactStatus = "pending" | "ok" | "error";
+
+export interface CompactState {
+	status?: CompactStatus;
+	summary?: string;
+}
+
+export interface CompactTheme {
+	fg(role: string, text: string): string;
+	bold(text: string): string;
+}
+
+export interface CompactContext {
+	state: CompactState & Record<string, unknown>;
+	lastComponent?: Component;
+	isError?: boolean;
+}
+
+interface CompactRow extends Component {
+	readonly compactWebRow: true;
+	label: string;
+	subject: string;
+	state: CompactState;
+	theme: CompactTheme;
+}
+
+function statusGlyph(status: CompactStatus | undefined): { glyph: string; role: string } {
+	if (status === "ok") return { glyph: "✓", role: "success" };
+	if (status === "error") return { glyph: "✗", role: "error" };
+	return { glyph: "●", role: "accent" };
+}
+
+function compactLine(label: string, subject: string, state: CompactState, theme: CompactTheme): string {
+	const { glyph, role } = statusGlyph(state.status);
+	let line = `${theme.fg(role, glyph)} ${theme.fg("accent", theme.bold(label))}`;
+	if (subject) line += theme.fg("text", ` · ${subject}`);
+	if (state.summary) line += theme.fg("dim", ` · ${state.summary}`);
+	return line;
+}
+
+function createRow(label: string, subject: string, state: CompactState, theme: CompactTheme): CompactRow {
+	return {
+		compactWebRow: true,
+		label,
+		subject,
+		state,
+		theme,
+		render(width: number) {
+			return [truncateToWidth(compactLine(this.label, this.subject, this.state, this.theme), width, "…")];
+		},
+		invalidate() {},
+	};
+}
+
+export function renderCompactCall(label: string, subject: string, theme: CompactTheme, context: CompactContext): Component {
+	if (context.state.status === undefined) context.state.status = "pending";
+	const previous = context.lastComponent as CompactRow | undefined;
+	const row = previous?.compactWebRow === true
+		? previous
+		: createRow(label, subject, context.state, theme);
+	row.label = label;
+	row.subject = subject;
+	row.state = context.state;
+	row.theme = theme;
+	return row;
+}
+
+export function settleCompactResult(
+	result: { details?: unknown },
+	context: CompactContext,
+	summary: string,
+): boolean {
+	const details = typeof result.details === "object" && result.details !== null
+		? result.details as Record<string, unknown>
+		: undefined;
+	const error = typeof details?.error === "string" ? details.error : undefined;
+	const failed = context.isError === true || error !== undefined;
+	context.state.status = failed ? "error" : "ok";
+	context.state.summary = failed ? firstLine(error ?? summary) : summary;
+	return failed;
+}
+
+export function emptyComponent(): Component {
+	return { render: () => [], invalidate() {} };
+}
+
+export function firstText(content: ReadonlyArray<{ type: string; text?: string }>): string {
+	return content.find((entry) => entry.type === "text" && typeof entry.text === "string")?.text ?? "";
+}
+
+export function firstLine(text: string): string {
+	return text.split("\n", 1)[0]?.trim() ?? "";
+}
+
+export function renderCompactMessage(
+	label: string,
+	status: Exclude<CompactStatus, "pending">,
+	subject: string,
+	summary: string,
+	theme: CompactTheme,
+	padding = 0,
+): Component {
+	const state = { status, summary } satisfies CompactState;
+	return {
+		render(width: number) {
+			const left = " ".repeat(Math.max(0, padding));
+			return [left + truncateToWidth(compactLine(label, subject, state, theme), Math.max(0, width - left.length), "…")];
+		},
+		invalidate() {},
+	};
+}
