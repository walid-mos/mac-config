      "Bash(cd:*)",
      "Bash(git :*)",
      "Bash(gh :*)",
      "Bash(glab :*)",
      "Bash(fnm :*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(readlink:*)",
      "Bash(test:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(tree:*)",
      "Bash(xargs:*)",
      "Bash(sed:*)",
      "Bash(node:*)",
      "Bash(yamllint:*)",
      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(docker stats:*)",
      "Bash(docker top:*)",
      "Bash(docker version:*)",
      "Bash(docker info:*)",
      "Bash(docker build:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo search:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo version:*)",
      "Bash(cargo --version:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo outdated:*)",
      "Bash(cargo audit:*)",
      "Bash(curl -s:*)",
      "Bash(curl -L:*)",
      "Bash(curl -I:*)",
      "Bash(curl --head:*)",
      "Bash(curl -G:*)",
      "Bash(curl --get:*)",
      "Bash(gh repo view:*)",
