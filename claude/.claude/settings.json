{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(cd:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(glab:*)",
      "Bash(fnm:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(readlink:*)",
      "Bash(test:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(tree:*)",
      "Bash(xargs:*)",
      "Bash(sed:*)",
      "Bash(perl:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(yamllint:*)",
      "Bash(zsh:*)",
      "Bash(ssh:*)",
      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(docker stats:*)",
      "Bash(docker top:*)",
      "Bash(docker version:*)",
      "Bash(docker info:*)",
      "Bash(docker build:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo search:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo version:*)",
      "Bash(cargo --version:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo outdated:*)",
      "Bash(cargo audit:*)",
      "Bash(curl -s:*)",
      "Bash(curl -L:*)",
      "Bash(curl -I:*)",
      "Bash(curl --head:*)",
      "Bash(curl -G:*)",
      "Bash(curl --get:*)",
      "Bash(dasel:*)",
      "Bash(jq:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh api --method GET:*)",
      "Bash(gh auth status:*)",
      "Bash(gh config get:*)",
      "Read(~/**)",
      "Edit(~/**)",
      "Write(~/**)",
      "Glob(~/**)",
      "Grep(~/**)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Write(//tmp/**)",
      "Glob(//tmp/**)",
      "Grep(//tmp/**)",
      "Bash(git commit:*)",
      "Bash(git ls-tree:*)",
      "Bash(git show:*)",
      "Bash(nvim:*)",
      "WebFetch",
      "WebSearch",
      "Bash(cloudflared:*)",
      "Bash(stow:*)",
      "Bash(cloudflared tunnel delete:*)",
      "mcp__linear-server__*",
      "mcp__github__*"
    ],
    "deny": [
      "Bash(curl -X POST:*)",
      "Bash(curl --request POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X DELETE:*)",
      "Bash(curl -X PATCH:*)",
      "Bash(curl -o:*)",
      "Bash(curl --output:*)",
      "Bash(curl -O:*)",
      "Bash(curl --remote-name:*)",
      "Bash(curl -d:*)",
      "Bash(curl --data:*)",
      "Bash(curl -F:*)",
      "Bash(curl --form:*)",
      "Bash(curl -T:*)",
      "Bash(curl --upload-file:*)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-tool-use.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/fallback-detector.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nextnode-brand-detector.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": false
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest"
}
