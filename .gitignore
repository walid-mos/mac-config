.DS_Store

# ZSH secrets (API keys)
zsh/.config/zsh/secrets

# Python cache files
__pycache__/
*.pyc
*.pyo

# Node modules
node_modules/

# pnpm store
.pnpm-store/


# gh: seul config.yml est versionné, hosts.yml contient le token OAuth
gh/.config/gh/*
!gh/.config/gh/config.yml

# Colima: ignore runtime data inside the stow package (only version _templates/)
colima/.config/colima/_lima/
colima/.config/colima/_store/
colima/.config/colima/default/
colima/.config/colima/ssh_config
colima/.config/colima/docker.sock
colima/.colima/

# Docker CLI: ignore runtime data inside the stow package (only version config.json)
docker/.docker/.token_seed
docker/.docker/.token_seed.lock
docker/.docker/buildx/
docker/.docker/contexts/

# pi: only version settings.json; auth.json contient les tokens, le reste est du runtime
pi/.pi/agent/*
!pi/.pi/agent/settings.json

# RTK: only version config.toml; ignore any runtime/cache data in the package
rtk/Library/Application Support/rtk/*
!rtk/Library/Application Support/rtk/config.toml
