{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Edit(/tmp/**)",
      "Edit(/Users/walid/.stow_repository/**)",
      "mcp__linear-server__*",
      "mcp__context7__*",
      "mcp__github__*",
      "mcp__dokploy__*",
      "mcp__cloudflare-observability__*",
      "mcp__cloudflare-dns__*",
      "mcp__plane__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf .)",
      "Bash(sudo *)",
      "Bash(curl -X POST *)",
      "Bash(curl --request POST *)",
      "Bash(curl -X PUT *)",
      "Bash(curl -X DELETE *)",
      "Bash(curl -X PATCH *)",
      "Bash(curl -d *)",
      "Bash(curl --data *)",
      "Bash(curl -F *)",
      "Bash(curl --form *)",
      "Bash(curl -o *)",
      "Bash(curl -O *)",
      "Bash(curl --output *)",
      "Bash(curl --remote-name *)",
      "Bash(curl -T *)",
      "Bash(curl --upload-file *)",
      "Bash(wget *)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(//Users/walid/.ssh/**)",
      "Read(//Users/walid/.aws/**)",
      "Read(**/credentials*)",
      "Read(**/*secret*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(//Users/walid/.ssh/**)",
      "Edit(//Users/walid/.aws/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init.py",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/context-detector.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-tool-use.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/fallback-detector.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["docker", "git"]
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest"
}
