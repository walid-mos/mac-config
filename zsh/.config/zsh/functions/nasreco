#!/bin/zsh
# Reconnect NAS volumes using mount_smbfs for clean Finder appearance

local verbose=false
local status_only=false
local force_remount=false
local quiet=false
local -a requested_shares=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --verbose|-v)
            verbose=true
            shift
            ;;
        --status|-s)
            status_only=true
            shift
            ;;
        --force|-f)
            force_remount=true
            shift
            ;;
        --quiet|-q)
            quiet=true
            shift
            ;;
        --help|-h)
            echo "Usage: nasreco [OPTIONS] [SHARE...]"
            echo ""
            echo "Reconnect NAS volumes using existing Keychain credentials."
            echo "Volumes appear as independent disks in Finder (not grouped under IP)."
            echo ""
            echo "Options:"
            echo "  --status, -s     Show mount status without reconnecting"
            echo "  --force, -f      Force remount even if already mounted"
            echo "  --quiet, -q      Non-interactive mode (for LaunchAgent/scripts)"
            echo "  --verbose, -v    Show detailed diagnostic information"
            echo "  --help, -h       Show this help message"
            echo ""
            echo "Arguments:"
            echo "  SHARE...         Specific shares to reconnect (default: all)"
            echo ""
            echo "Examples:"
            echo "  nasreco                    # Reconnect all shares"
            echo "  nasreco Storage Medias     # Reconnect only Storage and Medias"
            echo "  nasreco --status           # Show current mount status"
            echo "  nasreco --force            # Force remount all shares"
            echo "  nasreco --quiet            # Non-interactive for LaunchAgent"
            return 0
            ;;
        -*)
            echo "Error: Unknown option '$1'"
            echo "Usage: nasreco [OPTIONS] [SHARE...]"
            return 1
            ;;
        *)
            requested_shares+=("$1")
            shift
            ;;
    esac
done

# Helper function: URL-encode password for mount_smbfs
_url_encode_password() {
    local string="$1"
    local encoded=""
    local i char
    for (( i=0; i<${#string}; i++ )); do
        char="${string:$i:1}"
        case "$char" in
            [a-zA-Z0-9.~_-]) encoded+="$char" ;;
            *) encoded+=$(printf '%%%02X' "'$char") ;;
        esac
    done
    echo "$encoded"
}

# Helper function: Log message (respects quiet mode)
_log() {
    [[ "$quiet" = true ]] && return
    echo "$@"
}

# Helper function: Verbose log
_vlog() {
    [[ "$verbose" = true ]] && echo "$@"
}

# NAS Configuration
local nas_server="${NAS_SERVER:-192.168.1.2}"
local nas_username="${NAS_USERNAME:-wmostefaoui}"
local mount_base="${NAS_MOUNT_BASE:-$HOME/NAS}"
local keychain_service="nas-share-${nas_server}"

# Default shares if not specified
local -a all_shares=("Storage" "photo" "Exchange" "Medias")
local -a shares_to_process

if [[ ${#requested_shares[@]} -eq 0 ]]; then
    shares_to_process=("${all_shares[@]}")
else
    shares_to_process=("${requested_shares[@]}")
fi

_vlog "NAS Server: $nas_server"
_vlog "Username: $nas_username"
_vlog "Shares to process: ${shares_to_process[*]}"
_vlog ""

# Retrieve password from Keychain
_vlog "Retrieving password from Keychain (service: $keychain_service)..."
local nas_password=$(security find-generic-password -s "$keychain_service" -w 2>/dev/null)

if [[ -z "$nas_password" ]]; then
    _log "Error: Could not retrieve NAS password from Keychain"
    _log "Expected service name: $keychain_service"
    _log ""
    _log "Please ensure the NAS setup has been completed first."
    return 1
fi

_vlog "Password retrieved successfully"
_vlog ""

# URL-encode the password for mount_smbfs
local encoded_password=$(_url_encode_password "$nas_password")

# Check network connectivity
_vlog "Checking network connectivity to $nas_server..."
if ! ping -c 1 -W 2 "$nas_server" &>/dev/null; then
    _log "Error: Cannot reach NAS server at $nas_server"
    [[ "$quiet" = false ]] && _log "Please check your network connection."
    return 1
fi
_vlog "Network connectivity OK"
_vlog ""

# Process each share
local -a mounted_shares=()
local -a newly_mounted=()
local -a failed_shares=()

for share in "${shares_to_process[@]}"; do
    local mount_point="${mount_base}/${share}"

    # Check if already mounted
    if mount | grep -q "on ${mount_point} "; then
        mounted_shares+=("$share")

        if [[ "$status_only" = true ]]; then
            echo "[mounted] $share: $mount_point"
            continue
        fi

        if [[ "$force_remount" = false ]]; then
            if [[ "$quiet" = true ]]; then
                # In quiet mode, skip already mounted shares
                _vlog "Skipping $share (already mounted)"
                continue
            else
                echo "Share '$share' is already mounted at $mount_point"
                echo -n "Do you want to remount it? (y/N): "
                read -r response
                case $response in
                    [Yy]|yes)
                        _vlog "Unmounting $share..."
                        if ! umount "$mount_point" 2>/dev/null; then
                            _log "Warning: Failed to unmount $share, attempting diskutil..."
                            diskutil unmount "$mount_point" &>/dev/null
                        fi
                        ;;
                    *)
                        _log "Skipping $share"
                        continue
                        ;;
                esac
            fi
        else
            _vlog "Force unmounting $share..."
            if ! umount "$mount_point" 2>/dev/null; then
                diskutil unmount force "$mount_point" &>/dev/null
            fi
        fi
    else
        if [[ "$status_only" = true ]]; then
            echo "[unmounted] $share"
            continue
        fi
    fi

    # Skip mounting if status-only mode
    [[ "$status_only" = true ]] && continue

    # Create mount point directory if it doesn't exist
    if [[ ! -d "$mount_point" ]]; then
        _vlog "Creating mount point: $mount_point"
        if ! mkdir -p "$mount_point" 2>/dev/null; then
            _log "Error: Could not create mount point $mount_point"
            failed_shares+=("$share")
            continue
        fi
    fi

    # Mount using mount_smbfs (appears as independent volume in Finder)
    _log "Mounting $share..."
    local smb_url="//${nas_username}:${encoded_password}@${nas_server}/${share}"

    if mount_smbfs -o soft,noowners,nosuid "$smb_url" "$mount_point" 2>/dev/null; then
        _log "[ok] $share mounted at $mount_point"
        newly_mounted+=("$share")
    else
        _log "[failed] $share"
        failed_shares+=("$share")
        # Clean up empty mount point
        rmdir "$mount_point" 2>/dev/null
    fi
done

# Summary
if [[ "$status_only" = false && "$quiet" = false ]]; then
    echo ""
    echo "=== Summary ==="
    echo "Already mounted: ${#mounted_shares[@]}"
    echo "Newly mounted: ${#newly_mounted[@]}"
    if [[ ${#failed_shares[@]} -gt 0 ]]; then
        echo "Failed: ${#failed_shares[@]} (${failed_shares[*]})"
        return 1
    fi
fi

[[ ${#failed_shares[@]} -gt 0 ]] && return 1
return 0
